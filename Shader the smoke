-- 2. Base Lighting & Universal Shadow Setup
Lighting.Technology = Enum.Technology.Future
Lighting.GlobalShadows = true -- Enable global world shadows
Lighting.EnvironmentSpecularScale = 1
Lighting.EnvironmentDiffuseScale = 1

local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect", Lighting)
bloom.Intensity = 1.2
bloom.Size = 32
bloom.Threshold = 0.5

local sunRays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect", Lighting)
sunRays.Intensity = 0.85
sunRays.Spread = 0.9

local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere", Lighting)

-- Day / Night Lighting Config
local function applyNight()
    Lighting.ClockTime = 0
    Lighting.Brightness = 0.2
    Lighting.OutdoorAmbient = Color3.fromRGB(10, 12, 20)
    Lighting.Ambient = Color3.fromRGB(15, 18, 28)
    
    atmosphere.Density = 0.45
    atmosphere.Color = Color3.fromRGB(15, 20, 35)
    atmosphere.Decay = Color3.fromRGB(10, 12, 20)
end

local function applyDay()
    Lighting.ClockTime = 14
    Lighting.Brightness = 5
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)
    
    atmosphere.Density = 0.2
    atmosphere.Color = Color3.fromRGB(200, 220, 255)
    atmosphere.Decay = Color3.fromRGB(90, 100, 120)
end

local function updateButtonStyles()
    if currentMode == "DAY" then
        dayBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
        dayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        nightBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
        nightBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    elseif currentMode == "NIGHT" then
        nightBtn.BackgroundColor3 = Color3.fromRGB(140, 60, 255)
        nightBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        dayBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 45)
        dayBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

dayBtn.MouseButton1Click:Connect(function()
    currentMode = "DAY"
    updateButtonStyles()
    applyDay()
end)

nightBtn.MouseButton1Click:Connect(function()
    currentMode = "NIGHT"
    updateButtonStyles()
    applyNight()
end)

-- 3. Clock & Auto-Lighting Loop
local lastIsNight = nil

RunService.RenderStepped:Connect(function()
    local dateTable = os.date("*t")
    local hours = dateTable.hour
    local mins = dateTable.min
    local secs = dateTable.sec

    timeLabel.Text = string.format("🕒 %02d:%02d:%02d", hours, mins, secs)

    if currentMode == "AUTO" then
        local isNight = (hours >= 18 or hours < 6)
        if isNight ~= lastIsNight then
            lastIsNight = isNight
            if isNight then
                applyNight()
            else
                applyDay()
            end
        end
    end
end)

-- 4. Audio: Soft Looped Music + Ambient Birds
local function setupAudio(name, soundId, volume)
    local existing = SoundService:FindFirstChild(name)
    if existing then existing:Destroy() end

    local sound = Instance.new("Sound")
    sound.Name = name
    sound.SoundId = soundId
    sound.Volume = volume
    sound.Looped = true
    sound.Parent = SoundService
    sound:Play()
end

setupAudio("ShaderBirdSongs", "rbxassetid://9043887019", 0.4)
setupAudio("ShaderRelaxingMusic", "rbxassetid://9043887019", 0.25)

-- 5. Louder Footstep Audio Enhancer
local function enhanceFootsteps(character)
    local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoidRootPart then return end

    local runningSound = humanoidRootPart:WaitForChild("Running", 5)
    if runningSound and runningSound:IsA("Sound") then
        runningSound.Volume = 2.5
    end

    humanoidRootPart.ChildAdded:Connect(function(child)
        if child.Name == "Running" and child:IsA("Sound") then
            child.Volume = 2.5
        end
    end)
end

local localPlayer = Players.LocalPlayer
if localPlayer.Character then
    enhanceFootsteps(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(enhanceFootsteps)

-- 6. Make ALL parts (World, Props, NPCs, Entities) Reflective + Cast Shadows
local function processPart(part)
    if part:IsA("BasePart") then
        part.CastShadow = true -- Forces shadow rendering for every single part/NPC/entity
        part.Reflectance = 1 -- Mirror finish
    end
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
    processPart(descendant)
end

Workspace.DescendantAdded:Connect(processPart)

-- 7. Player Character Reflection & Shadows (Protect Head/Face)
local function applyCharacterReflection(character)
    local function processCharPart(part)
        if part:IsA("BasePart") then
            part.CastShadow = true -- Forces character body parts to cast shadows
            if part.Name == "Head" then
                part.Reflectance = 0 -- Keep skin & face natural
            else
                part.Reflectance = 0.65
            end
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        processCharPart(part)
    end
    
    character.DescendantAdded:Connect(processCharPart)
end

for _, player in ipairs(Players:GetPlayers()) do
    if player.Character then
        applyCharacterReflection(player.Character)
    end
    player.CharacterAdded:Connect(applyCharacterReflection)
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(applyCharacterReflection)
end)

print("✨ Shader with Universal Shadows for NPCs, Entities, and Parts Loaded!")
